---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={["sun", className]}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  {
    Array.from({ length: 12 }, (_, index) => (
      <rect
        x="30.25"
        y="3"
        width="3.5"
        height="15"
        rx="1.2"
        transform={`rotate(${index * 30} 32 32)`}
      />
    ))
  }
  <circle cx="32" cy="32" r="8"></circle>
</svg>
