---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.seo.title, description = site.seo.description } = Astro.props;

const ogImage = Astro.site ? new URL("/og.png", Astro.site).href : "/og.png";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description: site.seo.description,
  inLanguage: "pt-BR",
  areaServed: {
    "@type": "AdministrativeArea",
    name: site.location,
  },
  sameAs: [site.social.instagram],
  founder: {
    "@type": "Person",
    name: site.founder,
  },
  knowsAbout: site.menus.map((menu) => menu.title),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={site.seo.robots} />
    <meta name="theme-color" content="#FFF6E3" />
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Instrument+Serif:ital@0;1&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={site.seo.ogAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.seo.ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>
    <slot />
    <script is:inline>
      if (document.documentElement.classList.contains("motion")) {
        const nodes = document.querySelectorAll("[data-reveal]");
        const show = (el) => el.classList.add("is-in");
        const vh = window.innerHeight || 800;
        const pending = [];
        nodes.forEach((el) => {
          if (el.getBoundingClientRect().top < vh * 0.92) show(el);
          else pending.push(el);
        });
        if (pending.length && "IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  show(entry.target);
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12 },
          );
          pending.forEach((el) => io.observe(el));
        } else {
          pending.forEach(show);
        }
      }
    </script>
  </body>
</html>
